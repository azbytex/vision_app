<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- ══════════════════════════════════════════
         CAMERA PREVIEW (rounded corners, iPhone style)
         ══════════════════════════════════════════ -->
    <androidx.cardview.widget.CardView
        android:id="@+id/previewCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomControlBar"
        android:layout_marginTop="8dp"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Camera Preview -->
            <androidx.camera.view.PreviewView
                android:id="@+id/viewFinder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:scaleType="fillCenter" />

            <!-- AI Composition Overlay -->
            <com.visionframe.aicamera.ui.CameraOverlayView
                android:id="@+id/overlayView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Capture Flash Blink Effect -->
            <View
                android:id="@+id/captureFlash"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FFFFFFFF"
                android:alpha="0"
                android:visibility="visible" />

            <!-- AI Status Badge (top center, translucent pill) -->
            <LinearLayout
                android:id="@+id/aiStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="16dp"
                android:background="@drawable/badge_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:alpha="0">

                <View
                    android:id="@+id/aiPulse"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/pulse_dot"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvAiStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI sedang menganalisis..."
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Top Right Controls -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="14dp"
                android:orientation="vertical"
                android:gravity="center">

                <!-- Flash Button -->
                <ImageButton
                    android:id="@+id/btnFlash"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/icon_btn_bg"
                    android:src="@drawable/ic_flash_off"
                    android:contentDescription="Flash"
                    android:padding="8dp" />

                <!-- Settings -->
                <ImageButton
                    android:id="@+id/btnSettings"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/icon_btn_bg"
                    android:src="@drawable/ic_settings"
                    android:contentDescription="Settings"
                    android:padding="8dp"
                    android:layout_marginTop="10dp" />

            </LinearLayout>

            <!-- Zoom Selector Bar (bottom of preview) -->
            <LinearLayout
                android:id="@+id/zoomBar"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="14dp"
                android:background="@drawable/zoom_bar_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <TextView
                    android:id="@+id/zoom05x"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text=".5×"
                    android:textColor="#AAFFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/zoom1x"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="1×"
                    android:textColor="#FFFFC107"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-bold"
                    android:background="@drawable/zoom_selected_bg" />

                <TextView
                    android:id="@+id/zoom2x"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="2×"
                    android:textColor="#AAFFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/zoom4x"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="4×"
                    android:textColor="#AAFFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />

            </LinearLayout>

        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- ══════════════════════════════════════════
         BOTTOM CONTROL BAR (icon row above shutter)
         ══════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/bottomControlBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp"
        app:layout_constraintBottom_toTopOf="@id/shutterRow">

        <!-- Grid Toggle -->
        <ImageButton
            android:id="@+id/btnToggleGrid"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_grid"
            android:scaleType="fitCenter"
            android:contentDescription="Grid"
            android:alpha="0.7" />

        <!-- AI Mode / Scan -->
        <ImageButton
            android:id="@+id/btnAiMode"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_ai_scan"
            android:scaleType="fitCenter"
            android:contentDescription="AI Scan"
            android:alpha="0.7" />

        <!-- Aspect Ratio -->
        <ImageButton
            android:id="@+id/btnAspectRatio"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_aspect_ratio"
            android:scaleType="fitCenter"
            android:contentDescription="Aspect Ratio"
            android:alpha="0.7" />

    </LinearLayout>

    <!-- ══════════════════════════════════════════
         SHUTTER ROW (thumbnail + shutter + flip)
         ══════════════════════════════════════════ -->
    <RelativeLayout
        android:id="@+id/shutterRow"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:paddingStart="36dp"
        android:paddingEnd="36dp"
        app:layout_constraintBottom_toTopOf="@id/modeTabBar">

        <!-- Last Photo Thumbnail -->
        <ImageView
            android:id="@+id/imgLastPhoto"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/thumbnail_border"
            android:scaleType="centerCrop"
            android:contentDescription="Last photo"
            android:src="@drawable/logo" />

        <!-- Shutter Button (iPhone style white ring) -->
        <FrameLayout
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_centerInParent="true">

            <ImageButton
                android:id="@+id/btnShutter"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_gravity="center"
                android:background="@drawable/shutter_btn_bg"
                android:contentDescription="Capture"
                android:src="@android:color/transparent" />

            <!-- Video record indicator (red dot, hidden by default) -->
            <View
                android:id="@+id/videoRecordDot"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:background="@drawable/record_dot"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Flip Camera -->
        <ImageButton
            android:id="@+id/btnFlipCamera"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/icon_btn_bg_large"
            android:src="@drawable/ic_flip_camera"
            android:contentDescription="Flip Camera"
            android:padding="12dp" />

    </RelativeLayout>

    <!-- ══════════════════════════════════════════
         BOTTOM MODE TAB BAR (Photo / Video / Pro)
         ══════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/modeTabBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tabVideo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="VIDEO"
            android:textColor="#66FFFFFF"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/tabPhoto"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="FOTO"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/tabPro"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="PRO"
            android:textColor="#66FFFFFF"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05" />

    </LinearLayout>

    <!-- ══════════════════════════════════════════
         SPLASH SCREEN
         ══════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/splashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:elevation="30dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:src="@drawable/logo"
                android:contentDescription="Logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="VisionFrame"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:fontFamily="sans-serif-thin"
                android:letterSpacing="0.12" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="AI CAMERA"
                android:textColor="#80FFFFFF"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.25" />

            <ProgressBar
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="32dp"
                android:indeterminateTint="#FFFFFFFF" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
