# Auto detect text files and perform LF normalization
* text=auto

# Force Unix line endings for shell scripts
gradlew text eol=lf
*.sh text eol=lf

# Windows scripts use CRLF
gradlew.bat text eol=crlf

# Binary files (don't change line endings)
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.tflite binary
*.task binary
