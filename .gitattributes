# Set default behavior: auto-detect text files
* text=auto eol=lf

# Force LF for all shell scripts - CRITICAL for GitHub Actions
gradlew text eol=lf
*.sh text eol=lf

# Windows batch files use CRLF
gradlew.bat text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Android / XML / Kotlin source files use LF
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.java text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.pro text eol=lf

# Binary files — do NOT change line endings
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.tflite binary
*.task binary
*.apk binary
*.aar binary
*.zip binary
*.gz binary
*.tar binary
